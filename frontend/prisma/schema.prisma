// =============================================================================
// DeepAgent — corrected Prisma schema (redesign)
// -----------------------------------------------------------------------------
// Design rules applied (vs. the auto-generated schema.prisma):
//  1. No presentation strings as data. "2m ago", "$249/mo", "84.2k / day",
//     "Jun 28" become real DateTime / Int(cents) / Int columns. The UI does the
//     "2m ago" / "$x.xk" formatting at render time.
//  2. No duplicate Admin* tables. Admin dashboards are AGGREGATIONS/QUERIES over
//     the real User / Subscription / Invoice / Project tables. (see bottom note)
//  3. Real relations everywhere — FKs instead of loose strings (who, repo, env…).
//  4. Tenancy = PER-USER: a User owns Projects and has their own Subscription,
//     Usage, payment methods and invoices. Teammates are invited per-project.
//  5. Roles = enum owner | developer | viewer, carried on Membership.
//  6. Workloads + cloud resources unified into one ManagedResource model with
//     provisionedBy = terraform | kubernetes | manual, monitored when `enabled`.
//  7. Env rollback = immutable Deployment snapshots; Env points at its current one.
//
// Models marked  // ⚠ confirm   encode an assumption worth a sanity-check.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  // pgvector support for knowledge-base embeddings (KnowledgeChunk.embedding).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // requires `CREATE EXTENSION vector;` (pgvector)
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
enum ProjectRole {
  owner
  developer
  viewer
}

// Role inside a Team. Only a `lead` can create projects under the team and
// invite new members; a `member` inherits access to the team's projects.
// Kept deliberately small — three roles at the project level was already
// enough complexity; two here maps cleanly to "who decides" vs "who does".
enum TeamRole {
  lead
  member
}

// Global access tier on a User, granted only by an admin. Orthogonal to
// per-project Membership — a user with `full_all` sees every project without
// needing a Membership row per project. Modelled after AWS IAM's spectrum:
//
//   none      : sees ONLY projects where a Membership row exists (default).
//   view_all  : read-only across every project — no writes anywhere.
//   full_all  : developer-tier access across every project (no ownership).
//   admin     : super-admin; supersedes isSuperAdmin, does everything.
//
// `admin` is the platform admin — the account that creates users and grants
// these tiers. `isSuperAdmin` is kept as the boolean gate the /admin routes
// already check; the backfill promotes any existing isSuperAdmin=true user
// to globalAccess=admin so both stay in sync.
enum GlobalAccess {
  none
  view_all
  full_all
  admin
}

