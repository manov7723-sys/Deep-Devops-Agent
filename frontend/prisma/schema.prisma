// ---------------------------------------------------------------------------
// Identity / profile / auth
// ---------------------------------------------------------------------------
enum OAuthProvider {
  github
  google
  gitlab
}

// Git hosting provider of a Repo row. Separate from OAuthProvider on purpose:
// google is a valid OAuth provider but never a git host, and the two lists
// will diverge (e.g. bitbucket).
enum GitProvider {
  github
  gitlab
}

// Account-level role shown on the profile card. In per-user tenancy this
// reflects the account holder; project access is governed by Membership.role.
enum AccountRole {
  owner
  admin
  developer
  viewer
}

enum BillingPeriod {
  month
  year
  forever
  none
}

enum CardBrand {
  visa
  mastercard
  amex
  discover
  diners
  jcb
  unionpay
  unknown
}

enum TotpAlgorithm {
  SHA1
  SHA256
  SHA512
}

enum McpAuthType {
  none
  oauth
  credential
}

/**
 * MCP transport. `http` (Streamable HTTP) and `sse` talk to a REMOTE server
 * over the network — no binaries in the image. `stdio` spawns a local
 * subprocess and therefore requires that binary to be installed wherever the
 * app runs.
 */
enum McpTransport {
  http
  sse
  stdio
}

model User {
  id                    String      @id @default(uuid(7)) @db.Uuid
  email                 String      @unique
  name                  String
  firstName             String?
  lastName              String?
  avatarUrl             String?
  jobTitle              String?
  timezone              String?
  passwordHash          String?
  isSuperAdmin          Boolean     @default(false) // platform admin flag (NOT a project role)
  // Global project-access tier granted by an admin. Default `none` = the user
  // sees ONLY projects where they hold a Membership. See enum for the full
  // spectrum. Admin creates + assigns; users can't self-modify.
  globalAccess          GlobalAccess @default(none)
  role                  AccountRole @default(owner) // account-level role (profile card)
  twoFactorEnabled      Boolean     @default(false)
  emailVerifiedAt       DateTime? // set when an email_verify MagicLink is consumed
  lastPasswordChangedAt DateTime? // "Password last changed …"
  termsAcceptedAt       DateTime? // signup "I agree to Terms"
  stripeCustomerId      String?     @unique // Stripe Customer (cus_…); anchor for all billing
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // "project count" the UI wants = ownedProjects.length (derived, never stored stale)
  ownedProjects         Project[]
  memberships           Membership[]
  membershipsAdded      Membership[]        @relation("MembershipInvitedBy")
  invitationsSent       ProjectInvitation[] @relation("InvitationsSent")
  invitationsAccepted   ProjectInvitation[] @relation("InvitationsAccepted")
  // Teams — inverse sides of the relations declared on Team / TeamMembership
  // / TeamInvitation. Every named relation over there requires a matching
  // field here or Prisma's validator errors out.
  ownedTeams            Team[]              @relation("TeamOwner")
  teamMemberships       TeamMembership[]    @relation("TeamMembershipUser")
  teamMembershipsAdded  TeamMembership[]    @relation("TeamMembershipInvitedBy")
  teamInvitationsSent   TeamInvitation[]    @relation("TeamInvitedBy")
  teamInvitesAccepted   TeamInvitation[]    @relation("TeamInviteAcceptedBy")
  // "current subscription details" = this relation
  subscription          Subscription?
  // "current token usage" = usage counters + weekly samples
  usage                 Usage?
  usageSamples          UsageSample[]
  notifications         Notification[]
  backupCodes           BackupCode[]
  sessions              Session[]
  magicLinks            MagicLink[]
  paymentMethods        PaymentMethod[]
  invoices              Invoice[]
  repos                 Repo[]
  cloudProviders        CloudProvider[]
  chatMessages          ChatMessage[]
  activities            Activity[]
  approvalsDecided      Approval[]
  pipelinesRun          Pipeline[]
  deployments           Deployment[]
  knowledgeDocs         KnowledgeDoc[]
  integrationsConnected Integration[]
  checkoutSessions      CheckoutSession[]
  oauthAccounts         OAuthAccount[]
  totp                  TotpCredential?
  auditLogs             AuditLog[]
}

enum NotifKind {
  approval
  deployment
  alert
  billing
  member
  system
}

model Notification {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @db.Uuid
  category  NotifKind? // semantic kind; `icon` is the glyph the UI maps to
  icon      String
  title     String
  subtitle  String
  read      Boolean    @default(false)
  readAt    DateTime?
  linkHref  String? // deep-link target when the notification is clicked
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model BackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  batchId   String? // groups a regenerated set; "Regenerate" replaces the batch
  codeHash  String // never store the plaintext code
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, batchId])
}

// Server-side session (replaces the stateless ddasess/ddatemp cookie payloads).
// The cookie carries only `tokenHash`'s opaque token; the row holds the state.
// Flow: password verified -> pending_mfa (short TTL) -> TOTP ok -> active (7d).
enum SessionStatus {
  pending_mfa // ddatemp stage: awaiting TOTP
  active // ddasess stage: fully authenticated
  revoked
  expired
}

model Session {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @db.Uuid
  tokenHash       String        @unique // hash of the cookie token, never the raw token
  status          SessionStatus @default(pending_mfa)
  forcedTotpSetup Boolean       @default(false) // signup -> must set up TOTP
  rememberMe      Boolean       @default(false) // "Remember me" -> longer TTL
  mfaSatisfiedAt  DateTime? // when pending_mfa -> active (TOTP passed)
  // Step-up ("sudo mode"): a session cookie can be 30 days old, so login-time
  // MFA proves nothing about who is at the keyboard right now. Revealing
  // secret values requires a fresh re-auth that grants a short elevation
  // window. Failures are counted and locked out on the row (not in memory) so
  // the throttle survives restarts and works across instances.
  elevatedUntil     DateTime? // step-up valid until; null/past = not elevated
  stepUpFailures    Int       @default(0)
  stepUpLockedUntil DateTime?
  // Proof-of-possession for elevated reads. The cookie alone must NOT be
  // enough: browsers attach cookies to any request to the origin, so copying a
  // reveal URL out of devtools into curl replayed a live elevation. The raw
  // token is returned once by /auth/step-up, kept in page memory only, and
  // echoed back in the X-Reveal-Token header — something a pasted URL cannot
  // carry. Only the hash is stored.
  elevationTokenHash String?
  deviceLabel     String? // human label for the "Review devices" list
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  expiresAt       DateTime
  revokedAt       DateTime? // set on logout / "sign out other sessions"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt])
}

// Single-use emailed token: passwordless login, password reset, email verify,
// or invite. The email carries an opaque token; the DB stores only its hash.
enum MagicLinkPurpose {
  login
  password_reset
  email_verify
  invite
}

model MagicLink {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String?          @db.Uuid // null when the email isn't a known account yet (invite/signup)
  email       String // target email (always recorded)
  tokenHash   String           @unique
  purpose     MagicLinkPurpose
  expiresAt   DateTime
  consumedAt  DateTime? // set when redeemed; enforces single use
  requestedIp String?
  createdAt   DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

// OAuth sign-in identity ("Continue with GitHub/Google"). Links a provider
// account to a User; tokens stored as encrypted refs, never plaintext.
model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String // the user id at GitHub/Google
  /**
   * Denormalized handle from the provider (GitHub `login` or Google email
   * local-part). Used to render multi-account UIs without re-hitting the
   * provider's /user endpoint. Nullable for rows created before this column
   * was added; backfilled on next token refresh.
   */
  login             String?
  avatarUrl         String?
  accessTokenRef    String? // encrypted ref / secret-manager handle
  refreshTokenRef   String?
  tokenExpiresAt    DateTime?
  scope             String?
  /**
   * Base URL of the provider instance the token is bound to (e.g.
   * "https://gitlab.example.com" for self-hosted GitLab). Null means the
   * provider's default host (github.com / gitlab.com / google).
   */
  providerBaseUrl   String?
  createdAt         DateTime      @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  repos Repo[]

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// TOTP enrollment (1-to-1 with User). Distinguishes pending (secret created
// during forced setup) from confirmed (first valid code seen). Replaces the
// bare User.totpSecret string.
model TotpCredential {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @unique @db.Uuid
  secretRef   String // encrypted ref / secret-manager handle (never plaintext)
  label       String? // "Google Authenticator"
  algorithm   TotpAlgorithm @default(SHA1)
  digits      Int           @default(6)
  period      Int           @default(30)
  confirmedAt DateTime? // null until first valid code (pending vs confirmed)
  enrolledAt  DateTime      @default(now())
  disabledAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Billing — per-user subscription, plans, addons, invoices, usage
// ---------------------------------------------------------------------------
model Plan {
  id              String        @id @default(uuid(7)) @db.Uuid
  tier            PlanTier      @unique
  name            String
  // priceCents null + isCustomPrice = "Custom" (Enterprise).
  priceCents      Int?
  isCustomPrice   Boolean       @default(false)
  currency        String        @default("usd")
  period          BillingPeriod @default(month)
  popular         Boolean       @default(false)
  sortOrder       Int           @default(0) // catalog ordering
  // Stripe catalog mapping. Enterprise/Custom plans may have null prices.
  stripeProductId String? // prod_…
  stripePriceId   String? // price_… (monthly); add a yearly id if you offer annual
  // Entitlements: null = unlimited.
  projectLimit    Int?
  envLimit        Int?
  seatLimit       Int?
  agentTier       String? // "Community agents", "All agents + custom models", …
  highlights      String[]

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid(7)) @db.Uuid
  userId               String             @unique @db.Uuid // one active subscription per user
  planId               String             @db.Uuid
  status               SubscriptionStatus @default(incomplete)
  basePriceCents       Int
  currency             String             @default("usd")
  // Stripe references — Stripe is the source of truth; these are synced via webhook.
  stripeSubscriptionId String?            @unique // sub_…
  stripePriceId        String? // active price_…
  cancelAtPeriodEnd    Boolean            @default(false)
  // currentPeriodEnd = the "Renews on" date; renewsLabel holds non-date dunning
  // text for past_due/suspended rows ("Overdue 3d", "—") that has no date.
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  renewsLabel          String?
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  // Cached default card for display only (synced from Stripe); see PaymentMethod.
  paymentMethodId      String?            @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan                @relation(fields: [planId], references: [id])
  paymentMethod PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  addons        SubscriptionAddon[]
  invoices      Invoice[]
}

// Read-model CACHE of a Stripe payment method, for display only. The app never
// collects card data — cards are added/edited in Stripe's hosted Customer Portal,
// and these rows are kept in sync via webhooks. Stripe charges the customer; we
// don't store a chargeable token.
model PaymentMethod {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  stripePaymentMethodId String    @unique // pm_…
  brand                 CardBrand // normalized from Stripe's brand string
  last4                 String
  expMonth              Int
  expYear               Int
  // One default per user — enforce with a partial-unique index in a raw SQL
  // migration: CREATE UNIQUE INDEX ... ON "PaymentMethod"("userId") WHERE "isDefault".
  isDefault             Boolean   @default(false)
  createdAt             DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId])
}

// Catalog of purchasable add-ons. Add-ons are ONE-TIME purchases (mode=payment
// in Stripe Checkout). `tokenGrant` records how many agent tokens the purchase
// adds to the buyer's Usage.tokensGranted balance.
model Addon {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  icon            String
  description     String
  priceCents      Int
  currency        String   @default("usd")
  tokenGrant      Int      @default(0) // additional agent tokens added per purchase
  active          Boolean  @default(true) // hide retired add-ons without deleting
  stripeProductId String? // prod_…
  stripePriceId   String? // price_… (must be a ONE-TIME price in Stripe)
  createdAt       DateTime @default(now())

  purchases SubscriptionAddon[]
}

// A purchased add-on (a Stripe subscription item on the user's subscription).
// Admin "addon purchases" view = query over this + user.
model SubscriptionAddon {
  id                       String      @id @default(uuid(7)) @db.Uuid
  subscriptionId           String      @db.Uuid
  addonId                  String?     @db.Uuid
  name                     String // snapshot of the name at purchase time
  icon                     String
  priceCents               Int // purchase-time price snapshot
  status                   AddonStatus @default(active)
  stripeSubscriptionItemId String?     @unique // si_…
  purchasedAt              DateTime    @default(now())
  cancelledAt              DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon        Addon?       @relation(fields: [addonId], references: [id])

  @@index([subscriptionId])
}

// Mirror of a Stripe invoice (source of truth = Stripe; synced via webhook).
model Invoice {
  id               String        @id @default(uuid(7)) @db.Uuid
  stripeInvoiceId  String?       @unique // in_…
  number           String?       @unique // Stripe invoice number; null until finalized
  userId           String        @db.Uuid
  subscriptionId   String?       @db.Uuid
  customerName     String? // billing-entity label snapshot ("Northwind Commerce")
  amountCents      Int
  currency         String        @default("usd")
  status           InvoiceStatus
  hostedInvoiceUrl String? // Stripe-hosted invoice page
  pdfUrl           String? // invoice_pdf
  issuedAt         DateTime
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId, status])
  @@index([userId, issuedAt])
}

// Current-period usage counters. Limits derive from the plan but are cached
// here so per-user overrides (add-ons) are representable.
model Usage {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @unique @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  agentRunsUsed  Int      @default(0)
  agentRunsLimit Int? // null = unlimited
  deploysUsed    Int      @default(0)
  deploysLimit   Int?
  seatsUsed      Int      @default(0)
  seatsLimit     Int?
  envsUsed       Int      @default(0)
  envsLimit      Int?
  // Tokens are tracked separately from the run-count counters. `tokensGranted`
  // grows when a Token Boost addon is purchased; `tokensUsed` grows as agents
  // run. Remaining balance = tokensGranted + plan baseline - tokensUsed.
  tokensUsed     BigInt   @default(0)
  tokensGranted  BigInt   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Weekly token series for the usage sparkline (replaces the `tokens: Int[]` blob).
model UsageSample {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  weekStart DateTime
  tokens    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Stripe plumbing (redirect to Checkout / Customer Portal)
// ---------------------------------------------------------------------------
// Webhook idempotency + audit. On each webhook: insert by Stripe event id BEFORE
// processing and skip if it already exists -> exactly-once handling.
model StripeEvent {
  id          String    @id // Stripe event id (evt_…)
  type        String // "invoice.paid", "customer.subscription.updated", …
  apiVersion  String?
  payload     Json?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([type])
}

enum CheckoutMode {
  subscription
  setup
  payment
}

enum CheckoutStatus {
  open
  complete
  expired
}

// Correlates a redirect to Stripe Checkout with the initiating user + intent, so
// the success/cancel return and the async webhook reconcile to one record.
model CheckoutSession {
  id          String         @id // Stripe Checkout Session id (cs_…)
  userId      String         @db.Uuid
  mode        CheckoutMode
  status      CheckoutStatus @default(open)
  purpose     String? // "new_subscription" | "add_addon" | "update_payment_method"
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects + membership
// ---------------------------------------------------------------------------
model Project {
  id                  String       @id @default(uuid(7)) @db.Uuid
  slug                String       @unique
  ownerId             String       @db.Uuid
  // Which team OWNS this project. Nullable during the initial backfill
  // (2026-08) so the migration can run before every row is populated; once
  // all rows have a teamId a follow-up migration can NOT NULL it. Only a
  // team's `lead` can create projects under it — see POST /projects.
  teamId              String?      @db.Uuid
  name                String
  colorHue            Int
  description         String
  health              HealthStatus @default(ok)
  cloud               String? // the cloud this project targets: "aws" | "gcp" | "azure" (locks the Connect-provider UI)
  activeEnvKey        String? // the project's ACTIVE environment — env-scoped pages default to it (user-selectable)
  alertEmails         String[]     @default([]) // extra addresses that get alert emails (managed in the UI)
  // Ed25519 deploy keypair used to SSH into Proxmox VMs the project provisions.
  // Public key is baked into VM cloud-init on create; private key is stored
  // AES-GCM-encrypted (via lib/auth/crypto) and copied into a repo secret when
  // wiring the Proxmox deploy workflow. Both null until first Proxmox deploy.
  deployPublicKey     String? // OpenSSH format ("ssh-ed25519 AAAA… deploy@dda")
  deployPrivateKeyEnc String? // AES-256-GCM encrypted private key (PEM)
  archivedAt          DateTime? // "Archive project" (reversible) — read-only, agents paused
  deletedAt           DateTime? // soft-delete; retained for undo/audit before hard purge
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  owner             User                   @relation(fields: [ownerId], references: [id])
  memberships       Membership[]
  invitations       ProjectInvitation[]
  // `envs`, `repos` (counts) and `cloud[]` are DERIVED from these relations:
  environments      Env[]
  projectRepos      ProjectRepo[]
  pipelines         Pipeline[]
  ciPipelines       CiPipeline[]
  cloudProviders    CloudProvider[]
  approvals         Approval[]
  activities        Activity[]
  alerts            Alert[]
  alertThresholds   AlertThreshold[]
  chatOps           ChatOpsWebhook?
  uptimeMonitors    UptimeMonitor[]
  appSecrets        AppSecret[]
  vpnUserCerts      VpnUserCert[]
  scheduledDeploys  ScheduledDeploy[]
  deploymentRecords DeploymentRecord[]
  deployWatches     DeployWatch[]
  knowledgeDocs     KnowledgeDoc[]
  issues            Issue[]
  chatThreads       ChatThread[]
  chatMessages      ChatMessage[]
  chatSuggestions   ChatSuggestion[]
  tasks             Task[]
  resources         ManagedResource[]
  integrations      Integration[]
  mcpConnections    ProjectMcpConnection[]
  observabilityKpis ObservabilityKpi[]
  prometheusTargets PrometheusTarget[]
  grafanaDashboards GrafanaDashboard[]
  auditLogs         AuditLog[]
  settings          ProjectSetting?
  costSnapshots     CostSnapshot[]
  costTrend         CostTrendPoint[]
  tfRuns            TfRun[]
  reportRecipients  ReportRecipient[]
  reportRuns        ReportRun[]
  findings          Finding[]
  team              Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([teamId])
}

// An ACCEPTED member of a project (real User). Pending email invites live in
// ProjectInvitation, not here. lastActive is derived from Activity, not stored.
// The u/teams "projects" count per person = that user's Membership count.
model Membership {
  id          String      @id @default(uuid(7)) @db.Uuid
  projectId   String      @db.Uuid
  userId      String      @db.Uuid
  role        ProjectRole @default(viewer)
  invitedById String?     @db.Uuid // who added them (provenance)
  joinedAt    DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

// Pending email invite to a project — exists BEFORE the invitee has a Membership
// (and possibly before they have a User account at all). Resend = new MagicLink;
// accept = create Membership + mark accepted. Backs the InviteMemberModal flow.
enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model ProjectInvitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  projectId      String           @db.Uuid
  email          String // invitee — may not be a User yet
  role           ProjectRole      @default(viewer)
  status         InvitationStatus @default(pending)
  invitedById    String           @db.Uuid
  acceptedUserId String?          @db.Uuid // the User who accepted (set on accept)
  magicLinkId    String? // the emailed invite token (MagicLink.purpose = invite)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy    User    @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedUser User?   @relation("InvitationsAccepted", fields: [acceptedUserId], references: [id])

  @@unique([projectId, email]) // one live invite per email per project
  @@index([email])
}

model ProjectSetting {
  id                     String  @id @default(uuid(7)) @db.Uuid
  projectId              String  @unique @db.Uuid
  defaultBranch          String  @default("main")
  autoDeployNonProd      Boolean @default(true)
  requireApprovalRelease Boolean @default(true)
  defaultModelId         String? @db.Uuid

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultModel Model?  @relation(fields: [defaultModelId], references: [id])
}

// ---------------------------------------------------------------------------
// Repos — account-level (a connected GitHub repo), wired into projects & envs
// ---------------------------------------------------------------------------
model Repo {
  id             String         @id @default(uuid(7)) @db.Uuid
  ownerId        String         @db.Uuid // the user whose GitHub connection owns this repo
  /**
   * The specific OAuth identity row this repo was discovered through. A user
   * may have multiple connected GitHub accounts; this binds the repo to the
   * one whose token grants access. Nullable for rows created before this
   * column was added; backfilled lazily on next sync.
   */
  oauthAccountId String?        @db.Uuid
  provider       GitProvider    @default(github)
  fullName       String // e.g. "alice/api"; GitLab: path_with_namespace, may nest ("group/sub/repo")
  /**
   * Provider-native repo id (GitLab numeric project id as a string). Used for
   * API calls instead of the URL-encoded path — survives renames/transfers.
   * Null for GitHub rows (fullName is the API identity there).
   */
  providerRepoId String?
  name           String
  description    String?
  lang           String // TypeScript | HCL | YAML | Python | …
  kind           RepoKind
  defaultBranch  String         @default("main")
  visibility     RepoVisibility @default(private)
  openIssues     Int            @default(0)
  openPrs        Int            @default(0)
  lastCommitSha  String?
  lastCommitAt   DateTime?
  deletedAt      DateTime? // soft-delete on disconnect; retained for undo/audit
  createdAt      DateTime       @default(now())

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  oauthAccount    OAuthAccount?    @relation(fields: [oauthAccountId], references: [id], onDelete: SetNull)
  projectRepos    ProjectRepo[]
  envRepos        EnvRepo[]
  pipelines       Pipeline[]
  ciPipelines     CiPipeline[]
  issues          Issue[]
  knowledgeDocs   KnowledgeDoc[]
  deploymentRepos DeploymentRepo[]
  approvals       Approval[]
  chatPrRefs      ChatMessage[]    @relation("ChatPrRepo")
  chatPlanSteps   ChatPlanStep[]

  // The (oauthAccount, fullName) pair is the strong identity (matches reality:
  // the same `alice/api` repo can exist under two different connected
  // identities). (ownerId, fullName) is kept as a soft fallback for legacy
  // rows where oauthAccountId is null.
  @@unique([oauthAccountId, fullName])
  @@unique([ownerId, provider, fullName])
  @@index([ownerId])
  @@index([oauthAccountId])
}

// Repo ↔ Project association ("which repos belong to this project").
model ProjectRepo {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  repoId    String   @db.Uuid
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    Repo    @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([projectId, repoId])
}

// Repo wired into a specific environment, tracking a branch. This is the
// "map repo within the env" / "repo is part of envs" relationship.
model EnvRepo {
  id         String   @id @default(uuid(7)) @db.Uuid
  envId      String   @db.Uuid
  repoId     String   @db.Uuid
  branch     String
  autoDeploy Boolean  @default(false)
  createdAt  DateTime @default(now())

  env  Env  @relation(fields: [envId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([envId, repoId])
}

// ---------------------------------------------------------------------------
// Environments — each env picks a cloud provider, maps repos, keeps deploy history
// ---------------------------------------------------------------------------
model Env {
  id                           String   @id @default(uuid(7)) @db.Uuid
  projectId                    String   @db.Uuid
  cloudProviderId              String?  @db.Uuid // the cloud this env is deployed to (chosen at create)
  key                          String // "alpha" | "beta" | "release" | custom (no longer a fixed enum)
  name                         String
  url                          String?
  isProduction                 Boolean  @default(false)
  autoDeploy                   Boolean  @default(false)
  region                       String? // default cloud region for this env
  terraformWorkspace           String? // IaC workspace backing this env
  /**
   * Encrypted kubeconfig YAML the executor writes to disk before running
   * helm/kubectl. Null means "no cluster wired yet" — pipelines that need
   * Kubernetes will fail-fast with `env_missing_kubeconfig`.
   */
  kubeconfigRef                String?
  /**
   * Namespace to deploy app workloads into. Created if absent.
   */
  namespace                    String   @default("default")
  /**
   * Terraform remote-state backend bootstrap. On first Terraform use we
   * provision a per-project S3 bucket + DynamoDB lock table; the values are
   * recorded here so subsequent runs reference the same backend in their
   * HCL. Null means "Terraform not yet initialized for this env".
   */
  tfBackendBucket              String?
  tfBackendRegion              String?
  tfBackendTable               String?
  /**
   * GCP remote-state backend: single GCS bucket per env. GCS uses object
   * generations for locking, so no separate lock table is needed. Null means
   * "no GCS backend configured yet" — the tool falls back to local state.
   */
  tfBackendGcsBucket           String?
  /**
   * Azure remote-state backend: resource group + storage account + blob
   * container. Azure uses blob leases for locking natively (no separate lock
   * table needed). All three nullable — populated together or not at all.
   */
  tfBackendAzureResourceGroup  String?
  tfBackendAzureStorageAccount String?
  tfBackendAzureContainer      String?
  promotionRank                Int      @default(0) // ordering: alpha(0) -> beta(1) -> release(2)
  currentDeploymentId          String?  @unique @db.Uuid // active deployment; re-point to roll back
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cloudProvider     CloudProvider?       @relation(fields: [cloudProviderId], references: [id])
  currentDeployment Deployment?          @relation("EnvCurrentDeployment", fields: [currentDeploymentId], references: [id])
  deployments       Deployment[]         @relation("EnvDeployments")
  envRepos          EnvRepo[]
  resources         ManagedResource[]
  pipelines         Pipeline[]
  approvals         Approval[]
  alerts            Alert[]
  alertThresholds   AlertThreshold[]
  activities        Activity[]
  knowledgeDocs     KnowledgeDoc[]
  tasks             Task[]
  securityBindings  EnvSecurityBinding[]
  costByEnv         CostByEnv[]
  tfRuns            TfRun[]

  @@unique([projectId, key])
  @@index([projectId])
}

// Persistent Terraform pipeline run. Mirrors what used to live only in the
// runner's in-memory Map (which vanished on process restart / HMR). The
// runner still keeps a live copy for streaming logs; this row is upserted at
// each stage boundary so history + rerun capability survive restarts.
//
// stages / sourceFiles / sourceBackend are JSON because their shapes are
// tightly coupled to code in lib/devops/terraform-run.ts — modelling them as
// separate tables would spread the schema across everywhere the runner
// updates a stage.
model TfRun {
  id              String    @id // "tf_<random>" — set by runner, not a uuid
  projectId       String    @db.Uuid
  envId           String    @db.Uuid
  envKey          String
  cloudProviderId String?   @db.Uuid
  name            String
  action          String // "plan" | "apply"
  status          String // "queued" | "running" | "succeeded" | "failed"
  stages          Json      @default("[]") // TfStage[]
  sourceFiles     Json      @default("{}") // Record<path, content> — replays via Rerun
  sourceStack     String?
  sourceBackend   Json? // TfBackendCfg | null
  errorMessage    String?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  env     Env     @relation(fields: [envId], references: [id], onDelete: Cascade)

  @@index([projectId, envId, createdAt(sort: Desc)])
  @@index([envId, createdAt(sort: Desc)])
}

// Immutable deployment snapshot — the unit of rollback. Each deploy records the
// exact repo SHAs that went out; rollback = set Env.currentDeploymentId to a
// prior row (recorded as a new rolled_back Deployment if you want an audit trail).
model Deployment {
  id                 String           @id @default(uuid(7)) @db.Uuid
  envId              String           @db.Uuid
  sequence           Int // monotonically increasing per env (#1, #2, …)
  status             DeploymentStatus @default(running)
  triggeredById      String?          @db.Uuid // user, if human-triggered
  triggeredByAgentId String?          @db.Uuid
  rollbackOfId       String?          @db.Uuid // set when this deploy reverts to an earlier one
  // Infra state captured at deploy time — lets rollback revert INFRASTRUCTURE,
  // not just code SHAs. Re-applying these restores the env exactly.
  tfStateRef         String? // pointer to the Terraform state/version for this deploy
  tfPlanRef          String? // pointer to the applied terraform plan artifact
  infraSnapshot      Json? // resolved config (image tags, replicas, env-var refs)
  note               String?
  createdAt          DateTime         @default(now())
  finishedAt         DateTime?

  env              Env              @relation("EnvDeployments", fields: [envId], references: [id], onDelete: Cascade)
  currentOfEnv     Env?             @relation("EnvCurrentDeployment")
  triggeredBy      User?            @relation(fields: [triggeredById], references: [id])
  triggeredByAgent Agent?           @relation(fields: [triggeredByAgentId], references: [id])
  rollbackOf       Deployment?      @relation("DeploymentRollback", fields: [rollbackOfId], references: [id])
  rollbacks        Deployment[]     @relation("DeploymentRollback")
  repos            DeploymentRepo[]
  pipeline         Pipeline?

  @@unique([envId, sequence])
  @@index([envId])
}

// Per-repo SHA captured in a deployment (what code was live).
model DeploymentRepo {
  id           String   @id @default(uuid(7)) @db.Uuid
  deploymentId String   @db.Uuid
  repoId       String   @db.Uuid
  sha          String
  branch       String
  createdAt    DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  repo       Repo       @relation(fields: [repoId], references: [id])

  @@unique([deploymentId, repoId])
}

// ---------------------------------------------------------------------------
// Managed resources — unified workloads + cloud resources (k8s & terraform)
// ---------------------------------------------------------------------------
model ManagedResource {
  id              String           @id @default(uuid(7)) @db.Uuid
  projectId       String           @db.Uuid
  envId           String           @db.Uuid
  cloudProviderId String?          @db.Uuid
  name            String
  category        ResourceCategory
  type            String // "EKS · 6 nodes", "RDS Postgres · db.r6g.xlarge", …
  provisionedBy   ProvisionedBy    @default(terraform)
  enabled         Boolean          @default(true) // monitored when enabled
  region          String?
  status          HealthStatus     @default(ok)
  // Optional metrics — populated per resource kind.
  cpuPct          Int?
  memPct          Int?
  replicasReady   Int?
  replicasDesired Int?
  // Free-form extras the UI shows: badges[], policy hint, k8s requests/limits…
  attributes      Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  env           Env            @relation(fields: [envId], references: [id], onDelete: Cascade)
  cloudProvider CloudProvider? @relation(fields: [cloudProviderId], references: [id])

  @@index([projectId, envId])
  @@index([envId, category])
  @@index([category])
}

// ---------------------------------------------------------------------------
// CI/CD — pipelines + stages
// ---------------------------------------------------------------------------
model Pipeline {
  id                 String         @id @default(uuid(7)) @db.Uuid
  projectId          String         @db.Uuid
  envId              String         @db.Uuid
  repoId             String         @db.Uuid // repo is part of the env (see EnvRepo)
  branch             String
  sha                String
  status             PipelineStatus @default(running)
  triggeredById      String?        @db.Uuid
  triggeredByAgentId String?        @db.Uuid
  startedAt          DateTime       @default(now())
  finishedAt         DateTime?
  durationSec        Int?
  progressPct        Int            @default(0)
  attempt            Int            @default(1) // retry counter
  retryOfId          String?        @db.Uuid // the original run this is a retry of
  deploymentId       String?        @unique @db.Uuid // the deployment this run produced, if any

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  env              Env             @relation(fields: [envId], references: [id])
  repo             Repo            @relation(fields: [repoId], references: [id])
  triggeredBy      User?           @relation(fields: [triggeredById], references: [id])
  triggeredByAgent Agent?          @relation(fields: [triggeredByAgentId], references: [id])
  deployment       Deployment?     @relation(fields: [deploymentId], references: [id])
  retryOf          Pipeline?       @relation("PipelineRetry", fields: [retryOfId], references: [id])
  retries          Pipeline[]      @relation("PipelineRetry")
  stages           PipelineStage[]

  @@index([projectId, envId])
}

/// A CI/CD pipeline the agent generated, tracked so the CI/CD UI can trigger
/// and mirror its GitHub Actions run. Two ways a row gets here:
///   - "draft": the agent generated it in chat and the user SAVED it WITHOUT
///     committing to GitHub yet. "Run pipeline" commits `files` to the repo's
///     default branch AND triggers the workflow, together, on click.
///   - "committed": deploy_my_app already committed `files` directly (e.g. the
///     full-pipeline chat flow) — this row just mirrors what's on GitHub so it
///     shows up with a working "Run" button. Generated workflows trigger on
///     workflow_dispatch only (never push), so nothing runs until this button
///     is clicked; clicking re-commits only if `files` were edited since.
/// `files` (Dockerfile, workflow YAML, …) are editable in the CI/CD UI either
/// way. The app mirrors the run's live status. When `agentReview` is on, a
/// failed run is auto-reviewed, fixed, and re-run by the agent (bounded by
/// `healAttempts`).
model CiPipeline {
  id           String   @id @default(uuid(7)) @db.Uuid
  projectId    String   @db.Uuid
  repoId       String   @db.Uuid
  name         String
  files        Json // [{ path, content }] — editable
  workflowPath String? // path of the workflow file within `files`
  branch       String   @default("main")
  status       String   @default("draft") // draft | committed | committing | running | success | failed | error
  agentReview  Boolean  @default(false) // auto-heal failed runs with the agent
  healAttempts Int      @default(0) // bounds the auto-heal loop
  commitSha    String?
  runId        String? // GitHub Actions run id
  runUrl       String? // html_url of the run
  conclusion   String? // GitHub run conclusion (success|failure|…)
  stages       Json? // cached [{ name, status, conclusion, errorLog? }] for the UI
  lastError    String? // short error summary surfaced in the UI
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    Repo    @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PipelineStage {
  id         String      @id @default(uuid(7)) @db.Uuid
  pipelineId String      @db.Uuid
  label      String // human-readable name e.g. "Clone repos" or "Terraform plan"
  status     StageStatus
  order      Int
  createdAt  DateTime    @default(now())
  /**
   * Execution tracking — populated by the runner when the stage actually
   * runs against a cluster / cloud. Nullable so existing rows (display-only
   * stages from before Phase 1) still validate.
   */
  startedAt  DateTime?
  finishedAt DateTime?
  /**
   * Last ~32KB of stdout/stderr from the runner. Newer log lines win when
   * the buffer fills. For long runs, move to S3 in a later phase.
   */
  logs       String      @default("")
  exitCode   Int?

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId, order])
}

// ---------------------------------------------------------------------------
// Approvals
// ---------------------------------------------------------------------------
model Approval {
  id                 String         @id @default(uuid(7)) @db.Uuid
  projectId          String         @db.Uuid
  envId              String         @db.Uuid
  title              String
  summary            String?
  requestedByAgentId String?        @db.Uuid
  repoId             String?        @db.Uuid
  changesSummary     String? // "+3 resources", "1 file changed"
  risk               ApprovalRisk
  status             ApprovalStatus @default(pending)
  requestedAt        DateTime       @default(now())
  decidedAt          DateTime?
  decidedById        String?        @db.Uuid
  // Infra gate (Plan → policy → approval → apply): when kind="terraform" the
  // approval carries the executable payload + the estimate + policy result, so
  // approving it actually runs the apply.
  kind               String         @default("generic") // generic | terraform
  payloadJson        Json? // { type:"terraform", envKey, name, stack, files:[{path,content}] }
  costMonthly        Float? // estimated USD/month shown on the approval
  policyJson         Json? // policy check result { ok, violations[] }
  appliedAt          DateTime?
  applyRunId         String?

  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  env              Env            @relation(fields: [envId], references: [id])
  requestedByAgent Agent?         @relation(fields: [requestedByAgentId], references: [id])
  repo             Repo?          @relation(fields: [repoId], references: [id])
  decidedBy        User?          @relation(fields: [decidedById], references: [id])
  diff             ApprovalDiff[]

  @@index([projectId, status])
}

model ApprovalDiff {
  id         String   @id @default(uuid(7)) @db.Uuid
  approvalId String   @db.Uuid
  kind       DiffKind
  text       String
  order      Int

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
}

// ---------------------------------------------------------------------------
// Activity feed
// ---------------------------------------------------------------------------
model Activity {
  id           String   @id @default(uuid(7)) @db.Uuid
  projectId    String   @db.Uuid
  // Actor is a user OR an agent. actorLabel is a display fallback.
  actorUserId  String?  @db.Uuid
  actorAgentId String?  @db.Uuid
  actorLabel   String?
  action       String // "shipped", "approved", "flagged", …
  targetLabel  String // "northwind-api@9af20bc"
  targetType   String?
  envId        String?  @db.Uuid // null = shared / cross-env
  icon         String?
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser  User?   @relation(fields: [actorUserId], references: [id])
  actorAgent Agent?  @relation(fields: [actorAgentId], references: [id])
  env        Env?    @relation(fields: [envId], references: [id])

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------------
model Alert {
  id             String        @id @default(uuid(7)) @db.Uuid
  projectId      String        @db.Uuid
  envId          String        @db.Uuid
  title          String
  detail         String
  resource       String
  sourceAgentId  String?       @db.Uuid
  sourceLabel    String? // fallback when the source isn't a known Agent
  category       AlertCategory
  severity       AlertSeverity
  recommendation String
  status         AlertStatus   @default(open)
  detectedAt     DateTime      @default(now())
  resolvedAt     DateTime?
  // SRE agent auto-triage: the diagnosis JSON (summary/rootCause/evidence/
  // remediation/confidence) the agent produced when this alert fired, so the UI
  // can show it without the user clicking. Null = not yet investigated.
  aiDiagnosis    Json?
  aiDiagnosedAt  DateTime?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  env         Env     @relation(fields: [envId], references: [id])
  sourceAgent Agent?  @relation(fields: [sourceAgentId], references: [id])

  @@index([projectId, category])
  @@index([projectId, status])
}

// User-set alarm thresholds per environment + metric. Drives BOTH the live
// in-cluster evaluation and the cloud alarms (AWS/Azure/GCP). `percent` is a
// uniform 0–100 value; each consumer converts (e.g. GCP wants a 0–1 ratio).
model AlertThreshold {
  id        String        @id @default(uuid(7)) @db.Uuid
  projectId String        @db.Uuid
  envId     String        @db.Uuid
  metric    String // "cpu" | "memory" | "disk"
  percent   Int // 0–100 threshold
  severity  AlertSeverity @default(high)
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  env     Env     @relation(fields: [envId], references: [id], onDelete: Cascade)

  @@unique([envId, metric])
  @@index([projectId])
}

// ChatOps — an incoming webhook per project (Microsoft Teams or Slack) so
// alerts/deploys/errors post to the team's channel. The URL is encrypted.
model ChatOpsWebhook {
  id         String   @id @default(uuid(7)) @db.Uuid
  projectId  String   @unique @db.Uuid
  provider   String   @default("teams") // "teams" | "slack"
  webhookRef String // encrypted incoming webhook URL
  channel    String? // display-only label of the target channel
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Uptime / synthetic monitoring — periodically HTTP-check a deployed app URL and
// alert on downtime or slow response. Alerts flow through the normal pipeline
// (banner + email + Slack).
model UptimeMonitor {
  id               String    @id @default(uuid(7)) @db.Uuid
  projectId        String    @db.Uuid
  name             String
  url              String
  method           String    @default("GET")
  expectedStatus   Int       @default(200)
  intervalSec      Int       @default(300)
  enabled          Boolean   @default(true)
  // current state (updated each check)
  lastOk           Boolean?
  lastStatus       Int?
  lastLatencyMs    Int?
  lastCheckedAt    DateTime?
  consecutiveFails Int       @default(0)
  alertOpen        Boolean   @default(false)
  // TLS certificate expiry monitoring (https URLs).
  certExpiresAt    DateTime?
  certDaysWarn     Int       @default(21) // warn when the cert expires within this many days
  certAlertOpen    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks  UptimeCheck[]

  @@index([projectId])
}

model UptimeCheck {
  id        String   @id @default(uuid(7)) @db.Uuid
  monitorId String   @db.Uuid
  at        DateTime @default(now())
  ok        Boolean
  status    Int?
  latencyMs Int?
  error     String?

  monitor UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, at])
}

// Scheduled deployment — the agent lets a user "deploy later"; the background
// scheduler runs it at `runAt`, then notifies (email + ChatOps) like a normal deploy.
model ScheduledDeploy {
  id            String    @id @default(uuid(7)) @db.Uuid
  projectId     String    @db.Uuid
  createdById   String    @db.Uuid
  envKey        String
  appName       String
  image         String
  containerPort Int       @default(8080)
  replicas      Int       @default(1)
  envJson       Json? // [{ key, value }]
  expose        Boolean   @default(false)
  host          String?
  namespace     String?
  runAt         DateTime
  status        String    @default("pending") // pending | running | done | failed | cancelled
  // Approval gate: a scheduled deploy is approved UPFRONT (when scheduled). The
  // scheduler only runs it once approved=true; a rejection cancels it.
  approved      Boolean   @default(false)
  approvalId    String?   @db.Uuid
  result        String?
  ranAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([projectId])
}

// Deployment history — one row per deploy attempt (manual, scheduled, or agent).
// Powers the Deployments page: see what ran, who ran it, and one-click
// rollback/redeploy. Stores enough of the spec to redeploy the same image.
model DeploymentRecord {
  id            String   @id @default(uuid(7)) @db.Uuid
  projectId     String   @db.Uuid
  createdById   String?  @db.Uuid
  envKey        String
  appName       String
  image         String
  namespace     String
  containerPort Int      @default(8080)
  replicas      Int      @default(1)
  envJson       Json? // [{ key, value }] — so redeploy reuses the same env
  expose        Boolean  @default(false)
  host          String?
  status        String // succeeded | failed | rolled_back
  detail        String?
  source        String   @default("manual") // manual | scheduled | agent
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// Deploy watchdog — one row per successfully-deployed app the background
// scheduler keeps an eye on. If an app that WAS healthy stays unhealthy for
// several consecutive checks, the watchdog auto-rolls it back to the previous
// version. Registered/refreshed on every successful deploy.
model DeployWatch {
  id                   String    @id @default(uuid(7)) @db.Uuid
  projectId            String    @db.Uuid
  createdById          String?   @db.Uuid
  envKey               String
  appName              String
  namespace            String
  enabled              Boolean   @default(true)
  consecutiveUnhealthy Int       @default(0)
  lastHealthyAt        DateTime?
  lastCheckedAt        DateTime?
  autoRolledBackAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, envKey, appName, namespace])
  @@index([enabled])
}

// App secrets — encrypted key/value pairs a project can sync to its cluster as a
// Kubernetes Secret, so apps get their secrets at runtime WITHOUT plaintext in
// Git. Values are stored encrypted; they're never returned to the client.
model AppSecret {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  key       String
  valueRef  String // encrypted value
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Knowledge base
// ---------------------------------------------------------------------------
// A doc is either authored text (`source = written`) OR an uploaded file
// (`source = upload`, e.g. PDF/DOCX) that gets ingested into KnowledgeChunk
// rows for embedding-based retrieval.
enum KnowledgeSource {
  written
  upload
}

enum KnowledgeIngestStatus {
  pending // queued for chunking/embedding
  processing
  ready
  failed
}

model KnowledgeDoc {
  id            String                @id @default(uuid(7)) @db.Uuid
  projectId     String                @db.Uuid
  repoId        String?               @db.Uuid
  envId         String?               @db.Uuid // null = shared
  authorUserId  String?               @db.Uuid
  title         String
  excerpt       String
  body          String? // present for written docs
  type          KnowledgeType
  tags          String[]
  // Upload metadata — set when source = upload.
  source        KnowledgeSource       @default(written)
  fileName      String?
  mimeType      String? // "application/pdf", …
  fileSizeBytes Int?
  storageRef    String? // S3/GCS object key for the uploaded file
  pageCount     Int?
  ingestStatus  KnowledgeIngestStatus @default(ready)
  ingestError   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    Repo?            @relation(fields: [repoId], references: [id])
  env     Env?             @relation(fields: [envId], references: [id])
  author  User?            @relation(fields: [authorUserId], references: [id])
  chunks  KnowledgeChunk[]

  @@index([projectId])
}

// A retrievable chunk of a knowledge doc (split from body or an uploaded file),
// with its embedding for vector similarity search.
model KnowledgeChunk {
  id         String                       @id @default(uuid(7)) @db.Uuid
  docId      String                       @db.Uuid
  chunkIndex Int // ordinal within the doc
  content    String
  tokenCount Int?
  page       Int? // source page for PDFs
  // Dimension MUST match the embedding model (1536 = OpenAI text-embedding-3-small;
  // adjust for the model you use). Build an HNSW/IVFFlat index via raw SQL migration.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  doc KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, chunkIndex])
  @@index([docId])
}

// ---------------------------------------------------------------------------
// Issues (agent code review on project repos)
// ---------------------------------------------------------------------------
model Issue {
  id                String        @id @default(uuid(7)) @db.Uuid
  number            Int
  projectId         String        @db.Uuid
  repoId            String        @db.Uuid
  title             String
  note              String
  labels            String[]
  reviewedByAgentId String?       @db.Uuid
  verdict           IssueVerdict? // set when an agent review completes
  state             IssueState    @default(open)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo            Repo    @relation(fields: [repoId], references: [id])
  reviewedByAgent Agent?  @relation(fields: [reviewedByAgentId], references: [id])

  @@unique([repoId, number])
  @@index([projectId, state])
  @@index([reviewedByAgentId, verdict])
}

// ---------------------------------------------------------------------------
// Chat (agent conversation, per project)
// ---------------------------------------------------------------------------
model ChatThread {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([projectId])
}

model ChatMessage {
  id           String   @id @default(uuid(7)) @db.Uuid
  projectId    String   @db.Uuid
  threadId     String?  @db.Uuid // groups messages into a conversation
  role         ChatRole
  authorUserId String?  @db.Uuid // set when role = user
  agentId      String?  @db.Uuid // set when role = agent — which agent replied
  modelId      String?  @db.Uuid // model that generated the agent reply (optional)
  text         String
  codeBody     String?
  codeLang     String?
  prNumber     Int?
  prRepoId     String?  @db.Uuid
  createdAt    DateTime @default(now())

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread    ChatThread?    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User?          @relation(fields: [authorUserId], references: [id])
  agent     Agent?         @relation(fields: [agentId], references: [id])
  model     Model?         @relation(fields: [modelId], references: [id])
  prRepo    Repo?          @relation("ChatPrRepo", fields: [prRepoId], references: [id])
  planSteps ChatPlanStep[]

  @@index([projectId, createdAt])
  @@index([threadId])
}

model ChatPlanStep {
  id        String  @id @default(uuid(7)) @db.Uuid
  messageId String  @db.Uuid
  icon      String
  label     String
  repoId    String? @db.Uuid
  order     Int

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  repo    Repo?       @relation(fields: [repoId], references: [id])

  @@index([messageId])
}

model ChatSuggestion {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String?  @db.Uuid // null = global default suggestion
  icon      String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Scheduled agent tasks
// ---------------------------------------------------------------------------
model Task {
  id              String     @id @default(uuid(7)) @db.Uuid
  projectId       String     @db.Uuid
  agentId         String?    @db.Uuid
  envId           String?    @db.Uuid // null + allEnvs=true => runs across all envs
  allEnvs         Boolean    @default(false)
  title           String
  icon            String
  schedule        String // cron or human cadence; consider a typed cron later
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  status          TaskStatus @default(ok)
  findingsSummary String?
  progressPct     Int?
  createdAt       DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation(fields: [agentId], references: [id])
  env     Env?    @relation(fields: [envId], references: [id])

  @@index([projectId])
  @@index([nextRunAt])
}

// ---------------------------------------------------------------------------
// Cloud providers + security scopes
// ---------------------------------------------------------------------------
model CloudProvider {
  id                    String       @id @default(uuid(7)) @db.Uuid
  userId                String       @db.Uuid // who connected it
  projectId             String?      @db.Uuid // ISOLATION: a provider belongs to ONE project. The same cloud account reused in another project is a separate row.
  kind                  CloudKind
  name                  String
  accountRef            String // "northwind-prod · 461298145672"
  accountId             String?
  roleArn               String? // scoped IAM role the agent assumes (no long-lived keys)
  externalId            String? // STS AssumeRole ExternalId for cross-account trust
  // Long-lived AWS access key + secret, same AES-256-GCM-at-rest pattern as
  // Azure's spClientSecretEnc — no external secret store required. Null = no
  // long-lived keys stored (the provider relies on roleArn/externalId AssumeRole
  // or the server host's own AWS credentials instead).
  awsAccessKeyIdEnc     String?
  awsSecretAccessKeyEnc String?
  // Hybrid Azure auth. Populated when the OAuth callback auto-provisions a
  // Service Principal via Microsoft Graph (create AD app + password credential +
  // Contributor role assignment). Every keyless deploy / cluster op (federated
  // credentials, AKS admin grant, ACR OIDC) prefers these when present, so an
  // OAuth-connected project never falls back to ACR admin secrets.
  //   spClientId        = the auto-provisioned app registration's client id
  //   spClientSecretEnc = encrypted client secret (same AES-256-GCM as externalId)
  // Null on OAuth providers where auto-provisioning failed (permission consent
  // missing or the signed-in user isn't subscription Owner) and on legacy full-
  // SP connections (which still use roleArn + externalId for backward compat).
  spClientId            String?
  spClientSecretEnc     String?
  region                String
  // Azure active context (the agent remembers the user's picks per project):
  resourceGroup         String? // active Azure resource group
  cloudEnvironment      String       @default("AzurePublic") // AzurePublic | AzureUSGovernment | AzureChina
  // GCP Cloud Billing → BigQuery export dataset id (for cost queries). Null = not set up.
  costDatasetId         String?
  status                HealthStatus @default(ok)
  createdAt             DateTime     @default(now())

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // `envs` and `services`/`spend` (counts/sums) derive from these relations:
  environments   Env[]
  resources      ManagedResource[]
  securityScopes CloudSecurityScope[]

  @@index([userId])
  @@index([projectId])
}

// ⚠ confirm — "attach envs from security service for cloud": modelled as
// cloud-side security constructs (security groups, IAM roles, KMS keys, secret
// stores, network policies) that get bound to one or more environments.
model CloudSecurityScope {
  id              String            @id @default(uuid(7)) @db.Uuid
  cloudProviderId String            @db.Uuid
  kind            SecurityScopeKind
  name            String
  ref             String? // ARN / resource id
  metadata        Json?
  createdAt       DateTime          @default(now())

  cloudProvider CloudProvider        @relation(fields: [cloudProviderId], references: [id], onDelete: Cascade)
  bindings      EnvSecurityBinding[]

  @@index([cloudProviderId])
}

model EnvSecurityBinding {
  id        String   @id @default(uuid(7)) @db.Uuid
  envId     String   @db.Uuid
  scopeId   String   @db.Uuid
  createdAt DateTime @default(now())

  env   Env                @relation(fields: [envId], references: [id], onDelete: Cascade)
  scope CloudSecurityScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([envId, scopeId])
}

// ---------------------------------------------------------------------------
// Integrations (per-project) — two connectivity types: OAuth vs credential
// ---------------------------------------------------------------------------
// The settings "Connected services" panel mixes two connection flows:
//   • oauth      — GitHub / Slack / Grafana: authorize redirect, store tokens.
//   • credential — cloud (Role ARN), API-key / webhook services: enter secrets.
// `action` and `connected:boolean` from the mock are DROPPED — the UI derives
// the button label ("Connect" / "Manage" / "Configure") from authType + status.
// Note: cloud providers are also first-class CloudProvider rows; this Integration
// row is the connector card shown in settings. // ⚠ confirm scope (see chat).

enum IntegrationAuthType {
  oauth
  credential
}

enum IntegrationStatus {
  disconnected
  connected
  error
  expired // OAuth token lapsed / credential rejected
}

model Integration {
  id            String              @id @default(uuid(7)) @db.Uuid
  projectId     String              @db.Uuid
  provider      String // "github" | "cloud" | "grafana" | "slack" | …
  name          String
  icon          String
  description   String
  authType      IntegrationAuthType
  status        IntegrationStatus   @default(disconnected)
  connectedById String?             @db.Uuid // user who established the connection
  connectedAt   DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime            @default(now())

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectedBy User?                   @relation(fields: [connectedById], references: [id])
  oauth       IntegrationOAuth? // present when authType = oauth
  credentials IntegrationCredential[] // present when authType = credential

  @@unique([projectId, provider])
}

// OAuth connection detail — tokens stored as encrypted refs, never plaintext.
model IntegrationOAuth {
  id                   String    @id @default(uuid(7)) @db.Uuid
  integrationId        String    @unique @db.Uuid
  externalAccountId    String? // e.g. GitHub org/user id
  externalAccountLabel String? // "org northwind-io"
  accessTokenRef       String // ciphertext or secret-manager handle
  refreshTokenRef      String?
  scopes               String[]
  expiresAt            DateTime?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

// Credential connection detail — one row per config key (role_arn, region,
// api_key, webhook_url, …). Values are encrypted refs, never plaintext.
model IntegrationCredential {
  id            String  @id @default(uuid(7)) @db.Uuid
  integrationId String  @db.Uuid
  key           String // "role_arn" | "region" | "api_key" | "webhook_url"
  valueRef      String // ciphertext or secret-manager handle (null label-only if non-secret)
  isSecret      Boolean @default(true)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, key])
}

// ---------------------------------------------------------------------------
// Cost (structured — replaces the Cost Json blob)
// ---------------------------------------------------------------------------
model CostSnapshot {
  id            String   @id @default(uuid(7)) @db.Uuid
  projectId     String   @db.Uuid
  periodStart   DateTime // first day of the month this snapshot covers
  totalCents    Int
  forecastCents Int?
  budgetCents   Int?
  savingsCents  Int?
  untaggedCents Int?
  createdAt     DateTime @default(now())

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  byEnv     CostByEnv[]
  byService CostByService[]

  @@unique([projectId, periodStart])
}

model CostByEnv {
  id          String   @id @default(uuid(7)) @db.Uuid
  snapshotId  String   @db.Uuid
  envId       String?  @db.Uuid
  label       String // "Release", "Shared" (Shared has no Env)
  amountCents Int
  createdAt   DateTime @default(now())

  snapshot CostSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  env      Env?         @relation(fields: [envId], references: [id])

  @@index([snapshotId])
}

model CostByService {
  id          String   @id @default(uuid(7)) @db.Uuid
  snapshotId  String   @db.Uuid
  service     String // "EKS · compute"
  amountCents Int
  pct         Int?
  createdAt   DateTime @default(now())

  snapshot CostSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
}

// 12-month trend series for the cost chart.
model CostTrendPoint {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @db.Uuid
  monthStart  DateTime
  amountCents Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, monthStart])
}

// ---------------------------------------------------------------------------
// Observability (ProjStats tab) — persisted KPIs + monitoring links
// ---------------------------------------------------------------------------
model ObservabilityKpi {
  id         String       @id @default(uuid(7)) @db.Uuid
  projectId  String       @db.Uuid
  envId      String?      @db.Uuid
  name       String // "API latency p95"
  value      String // display value ("84 ms")
  unit       String?
  tone       HealthStatus @default(ok)
  series     Int[] // sparkline points
  capturedAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum TargetStatus {
  up
  down
}

model PrometheusTarget {
  id        String       @id @default(uuid(7)) @db.Uuid
  projectId String       @db.Uuid
  name      String
  status    TargetStatus
  series    Int? // active series count
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model GrafanaDashboard {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  title     String
  url       String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Platform: agents + models + MCP (admin-configured, used across projects)
// ---------------------------------------------------------------------------
// Admin-managed platform agents (not user-owned), referenced across projects.
model Agent {
  id                 String   @id @default(uuid(7)) @db.Uuid
  name               String
  skill              String
  triggerDescription String // "On issue + PR", "Daily", …
  approvalPolicy     String // "Auto-close low risk", "Human for prod", …
  modelId            String?  @db.Uuid
  enabled            Boolean  @default(true)
  systemPrompt       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  model        Model?        @relation(fields: [modelId], references: [id])
  approvals    Approval[]
  activities   Activity[]
  alerts       Alert[]
  tasks        Task[]
  pipelines    Pipeline[]
  issues       Issue[]
  deployments  Deployment[]
  chatMessages ChatMessage[]
}

model Model {
  id                     String        @id @default(uuid(7)) @db.Uuid
  name                   String
  provider               ModelProvider
  ctxTokens              Int? // 200_000, 1_000_000 (parsed from "200k"/"1M")
  inputCostPerMTokCents  Int? // parsed from "$3 / $15 per Mtok"
  outputCostPerMTokCents Int?
  costNote               String? // "GPU node", or free-form when not per-token
  // Admin-managed catalog. `isDefault` is the platform default model used by
  // every user across all projects; ProjectSetting.defaultModelId can override
  // it per project. Models are not user-owned.
  isDefault              Boolean       @default(false)
  enabled                Boolean       @default(true)

  agents         Agent[]
  projectDefault ProjectSetting[]
  chatMessages   ChatMessage[]
}

model McpConnector {
  id             String      @id @default(uuid(7)) @db.Uuid
  name           String
  description    String
  status         McpStatus   @default(ok)
  authType       McpAuthType @default(none)
  avgCallsPerDay Int? // parsed from "84.2k / day"
  avgLatencyMs   Int? // parsed from "120ms"
  createdAt      DateTime    @default(now())

  // ── How to actually reach this server ────────────────────────────────
  // Until these existed the MCP tables stored metadata + credentials but no
  // way to CONNECT, so the admin UI was a registry the agent could never use.
  //
  //   transport = http | sse → `url` is the server endpoint. Nothing extra is
  //     needed in the container image, which is what makes MCP usable from a
  //     deployed pod (see the 2026-08 "aws CLI is not installed" incident).
  //   transport = stdio      → `command` + `args` are spawned as a subprocess.
  //     The binary MUST exist in the image, so this is really only viable for
  //     local development or a purpose-built image.
  transport McpTransport @default(http)
  /** Endpoint for http/sse transports, e.g. https://mcp.example.com/sse */
  url       String?
  /** Executable for stdio transport, e.g. "npx" or "uvx". */
  command   String?
  /** Argv for stdio transport, e.g. ["-y","@some/mcp-server"]. */
  args      String[]     @default([])
  /** Master switch — disabled connectors are never dialled or listed. */
  enabled   Boolean      @default(true)

  oauth              McpOAuth?
  credentials        McpCredential[]
  projectConnections ProjectMcpConnection[]
}

// Platform-level OAuth for an MCP server (admin-authorized). For per-project
// authorization, attach tokens to ProjectMcpConnection instead.
model McpOAuth {
  id                  String    @id @default(uuid(7)) @db.Uuid
  connectorId         String    @unique @db.Uuid
  accessTokenRef      String // encrypted ref, never plaintext
  refreshTokenRef     String?
  scopes              String[]
  tokenType           String? // "Bearer"
  authorizationServer String? // OAuth issuer / discovery URL
  expiresAt           DateTime?

  connector McpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
}

model McpCredential {
  id          String  @id @default(uuid(7)) @db.Uuid
  connectorId String  @db.Uuid
  key         String // "api_key" | "pat" | "aws_role_arn" | …
  valueRef    String // encrypted ref, never plaintext
  isSecret    Boolean @default(true)

  connector McpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, key])
}

// The missing Project <-> MCP link: a project's connection to an MCP server.
// Per-project authorization (when used) lives here.
model ProjectMcpConnection {
  id            String            @id @default(uuid(7)) @db.Uuid
  projectId     String            @db.Uuid
  connectorId   String            @db.Uuid
  enabled       Boolean           @default(true)
  status        IntegrationStatus @default(disconnected)
  connectedById String?           @db.Uuid // user id (soft ref) who established the connection
  connectedAt   DateTime?
  createdAt     DateTime          @default(now())

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connector McpConnector @relation(fields: [connectorId], references: [id])

  @@unique([projectId, connectorId])
}

// ---------------------------------------------------------------------------
// Platform settings (admin) — small singleton-ish config tables
// ---------------------------------------------------------------------------
/// Recipients of the scheduled application report, scoped to ONE namespace.
///
/// Reports are addressed per NAMESPACE rather than per project or per env,
/// because a namespace is what the user actually recognises as "an app" —
/// it's the title they see on the Reports tab and the unit the deploy flow
/// asks them to pick. A project may span several namespaces across clouds,
/// and each can have a different audience (the payments team shouldn't get
/// the marketing site's pod restarts).
model ReportRecipient {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  /// Kubernetes namespace this recipient receives reports for.
  namespace String
  email     String
  /// Set false to pause delivery without losing the address.
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// One row per (project, namespace, email) — re-adding an existing address
  /// is an update, never a duplicate that mails someone twice.
  @@unique([projectId, namespace, email])
  @@index([projectId, namespace])
}

/// Audit trail of report deliveries, so the scheduler can tell "already sent
/// today" from "never ran" after a restart, and the UI can show when a
/// namespace last received its report.
model ReportRun {
  id         String   @id @default(uuid(7)) @db.Uuid
  projectId  String   @db.Uuid
  namespace  String
  /// Local calendar day the report covers, as YYYY-MM-DD. Used for the
  /// once-per-day guard — a timestamp alone would re-send after a restart.
  reportDate String
  status     String // "sent" | "failed" | "skipped"
  /// Addresses actually mailed, comma-joined. Empty when status != "sent".
  recipients String   @default("")
  /// Failure reason, or a short summary on success.
  detail     String   @default("")
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, namespace, reportDate])
  @@index([projectId, createdAt])
}

model PlatformSetting {
  id              String    @id @default(uuid(7)) @db.Uuid
  siteTitle       String
  metaDescription String
  smtpHost        String?
  smtpPort        Int?
  fromAddress     String?
  smtpVerifiedAt  DateTime? // when SMTP was last verified (NOT a user's email)
  /// AES-256-GCM ciphertext of the SMTP password. Encrypted rather than
  /// plaintext because this row is readable by any settings surface, and a
  /// mail relay credential is a real secret — it can send as your domain.
  /// Never returned to a client; the API reports only whether it is set.
  smtpPasswordRef String?
  smtpUser        String? // defaults to fromAddress when unset
  updatedAt       DateTime  @updatedAt
}

model PlatformAsset {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique // "logo" | "favicon" | "og"
  label     String
  hint      String
  url       String?
  updatedAt DateTime @updatedAt
}

// Secret config — store an encrypted reference/handle, NEVER the plaintext value.
model PlatformEnvVar {
  id          String       @id @default(uuid(7)) @db.Uuid
  key         String       @unique
  valueRef    String // encrypted ciphertext or secret-manager handle
  status      HealthStatus @default(ok)
  statusLabel String // "Set" | "Expiring" | …
  updatedAt   DateTime     @updatedAt
}

// OAuth client credentials managed from the admin UI rather than env vars,
// so an operator can rotate keys without redeploying. clientSecretRef holds
// the AES-GCM ciphertext of the client secret; clientId is stored plaintext
// (it's already shipped to the browser as part of the authorize URL).
model OAuthProviderConfig {
  id              String        @id @default(uuid(7)) @db.Uuid
  provider        OAuthProvider @unique
  clientId        String // public — appears in the authorize URL
  clientSecretRef String // AES-GCM ciphertext via encryptSecret()
  enabled         Boolean       @default(true)
  updatedAt       DateTime      @updatedAt
}

// ⚠ confirm — system health is really live/runtime; persisted here only so the
// admin status board has something to render. Could be replaced by live checks.
model SystemComponent {
  id     String       @id @default(uuid(7)) @db.Uuid
  key    String       @unique
  name   String
  status HealthStatus @default(ok)
  note   String
}

// ---------------------------------------------------------------------------
// Security audit log — immutable, append-only trail of sensitive events
// ---------------------------------------------------------------------------
// Distinct from the per-project Activity feed (display-oriented). Records
// account/billing/auth-sensitive events: logins, MFA enroll/disable, backup-code
// regen, session revoke, password/email changes, plan/payment changes, role
// changes, invite accept/revoke, deploy/rollback approvals.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @db.Uuid // actor (null = system)
  projectId  String?  @db.Uuid // scope, when project-related
  action     String // "user.login", "mfa.disabled", "deploy.rollback", "billing.plan_changed"
  targetType String?
  targetId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

// =============================================================================
// AWS Client VPN — per-user client certificates issued on demand against
// an existing endpoint's CA. Each row = one cert we minted, stored so the
// user can re-download the same file later without invalidating the cert
// by re-minting. All PEMs are AES-256-GCM encrypted at rest (via
// encryptSecret) — never returned in plaintext except through the
// authenticated download endpoint.
// =============================================================================
model VpnUserCert {
  id         String @id @default(uuid(7)) @db.Uuid
  projectId  String @db.Uuid
  approvalId String @db.Uuid // The Client VPN approval (identifies the endpoint + CA)
  userName   String // The CN on this cert — shows in AWS Connection Log
  serial     String // Hex serial number of the X.509 cert (for revocation)

  // Encrypted PEMs (AES-256-GCM via encryptSecret / decryptSecret).
  certPemEnc    String // client X.509 cert
  privateKeyEnc String // client private key
  caPemEnc      String // shared CA cert (snapshot at issue time, so re-download is
  // consistent even if the VPN's CA is later replaced)

  // Optional embedded .ovpn base config for one-click re-download. When
  // omitted we can still re-download the raw cert/key/ca — the .ovpn just
  // won't be self-contained.
  ovpnBaseEnc String?

  // Endpoint metadata — captured at issue time so re-download can call
  // `aws ec2 export-client-vpn-client-configuration` LIVE if the stored
  // ovpnBaseEnc is missing / stale. Never store the region in the encrypted
  // payload; it's not sensitive.
  endpointId  String?
  endpointDns String?
  region      String?

  issuedAt     DateTime  @default(now())
  issuedById   String?   @db.Uuid
  revokedAt    DateTime?
  revokedById  String?   @db.Uuid
  // Days of validity used when signing — informational; the real expiry is
  // baked into the cert bytes.
  validityDays Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, approvalId, revokedAt])
  @@index([approvalId, issuedAt])
}

// =============================================================================
// DELIBERATELY OMITTED (were duplicate tables in the generated schema):
//   AdminUser          -> User (filter/aggregate)
//   AdminPlan          -> Plan (entitlements merged in)
//   AdminSubscription  -> Subscription
//   AdminAddonPurchase -> SubscriptionAddon
//   AdminInvoice       -> Invoice
//   AdminKpi           -> COMPUTED: MRR/ARR/users/projects/envs/churn are
//                         aggregations over Subscription/User/Project/Env.
//   BillingStat        -> COMPUTED: collected/outstanding/failed/refunds are
//                         aggregations over Invoice.
// Admin screens read the real tables; they do not get their own copies.
// =============================================================================

// ── Security findings ──────────────────────────────────────────────────────
//
// One row per DISTINCT issue a scanner surfaces, deduped by
// (scanner, ruleId, target). Rescans update the same row (`lastSeenAt`,
// severity if it changed); an issue not surfaced by a later scan flips to
// `fixed` via a separate resolver — a finding disappearing from a scan output
// is meaningful and shouldn't be treated as "still open".
//
// This is deliberately NOT the Alert model: an Alert is "production is on
// fire right now", a Finding is "a scanner reported this and someone should
// look at it before the SLA runs out". Notify triggers an Alert only when
// the SLA breaches (see lib/secops/severity.ts and notify.ts).
model Finding {
  id           String            @id @default(uuid(7)) @db.Uuid
  projectId    String            @db.Uuid
  envKey       String? // optional: findings from a repo scan aren't env-scoped
  scanner      String // "trivy" | "gitleaks" | "semgrep" | "npm-audit" | "checkov" | "kube-bench" | "prowler"
  ruleId       String // CVE / rule id / secret rule — the scanner's stable id
  target       String // file path, package name, resource ARN — whatever the scanner names
  severity     FindingSeverity
  title        String
  description  String?
  fixedVersion String? // when scanner suggests one (Trivy vulns, npm-audit)
  status       FindingStatus     @default(open)
  firstSeenAt  DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  fixedAt      DateTime?
  suppressedAt DateTime?
  suppressedBy String? // user id who muted this; audit reads through AuditLog
  slaAlertedAt DateTime? // notify.ts stamps this once so we don't re-alert every scan
  metadata     Json? // raw scanner-specific fields (package version, cvss, etc.)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, scanner, ruleId, target], name: "finding_dedupe")
  @@index([projectId, status, severity])
  @@index([projectId, scanner])
  @@index([status, severity, firstSeenAt]) // notify.ts SLA sweep
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO // scanner emits this but we don't SLA it
}

enum FindingStatus {
  open
  fixed // seen previously, absent from a later scan (or explicitly marked)
  suppressed // muted by a user with a reason recorded in AuditLog
}

// ── Teams ──────────────────────────────────────────────────────────────────
//
// A Team owns Projects. Only a team lead can create projects under the team
// and invite members. Members inherit access to the team's projects — the
// per-project Membership table still governs role granularity there, but
// team-level membership is the gate on WHO gets a Membership at all when a
// project is created.
//
// Added 2026-08 in response to "only team leads should create projects, and
// the lead should add members by email". Backfilled so no existing project
// is orphaned: every current owner becomes lead of a personal team, other
// existing project members become team members.
model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  // The user who created the team. Kept for provenance + as an initial fallback
  // lead — do NOT gate permissions off this field alone; check TeamMembership.
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id])
  memberships TeamMembership[]
  invitations TeamInvitation[]
  projects    Project[]

  @@index([ownerId])
}

model TeamMembership {
  id          String   @id @default(uuid(7)) @db.Uuid
  teamId      String   @db.Uuid
  userId      String   @db.Uuid
  role        TeamRole @default(member)
  invitedById String?  @db.Uuid
  joinedAt    DateTime @default(now())

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User  @relation("TeamMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("TeamMembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, role])
}

// Email invite to join a Team. Same shape as ProjectInvitation on purpose
// so the magic-link accept flow can be extended in one place. Kept as a
// separate table because a Team invite grants team-wide access, not access
// to one specific project — different lifecycle.
model TeamInvitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  teamId         String           @db.Uuid
  email          String
  role           TeamRole         @default(member)
  status         InvitationStatus @default(pending)
  invitedById    String           @db.Uuid
  acceptedUserId String?          @db.Uuid
  magicLinkId    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy     User  @relation("TeamInvitedBy", fields: [invitedById], references: [id])
  acceptedUser  User? @relation("TeamInviteAcceptedBy", fields: [acceptedUserId], references: [id])

  // One live invite per address per team — reinviting the same email refreshes
  // this row rather than piling up duplicates, matching ProjectInvitation.
  @@unique([teamId, email], name: "team_email_unique")
  @@index([teamId, status])
  @@index([email, status])
}
